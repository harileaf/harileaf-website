---
/**
 * TimelineItem — "Our Journey" milestone on the about page.
 *
 * Updated pattern from design:
 *   - Year rendered as large faded number (text-7xl/8xl font-black opacity-20)
 *   - Optional image beside content (alternating layout via reverse prop)
 *   - Title + description
 *   - When image provided: grid grid-cols-1 lg:grid-cols-2 gap-12
 *   - When no image: stacked space-y-4
 *
 * Props:
 *   year        — year string e.g. "2018" (rendered large + faded)
 *   title       — milestone title
 *   description — milestone body text
 *   image       — optional image src
 *   imageAlt    — alt text
 *   reverse     — flip image to left, text to right (default: false)
 *   class       — extra classes
 */
interface Props {
  year: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
  class?: string;
}

const {
  year,
  title,
  description,
  image,
  imageAlt = '',
  reverse = false,
  class: className = '',
} = Astro.props;
---

{image ? (
  <div class:list={['grid grid-cols-1 lg:grid-cols-2 gap-12 items-center', className]}>
    <!-- Image col -->
    <div class:list={[reverse ? 'lg:order-2' : 'lg:order-1']}>
      <div class="aspect-video rounded-xl overflow-hidden shadow-sm">
        <img src={image} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
    <!-- Content col -->
    <div class:list={['space-y-4', reverse ? 'lg:order-1' : 'lg:order-2']}>
      <div class="text-primary font-black text-7xl opacity-20 leading-none select-none" aria-hidden="true">{year}</div>
      <h3 class="text-2xl font-bold text-on-surface">{title}</h3>
      <p class="text-on-surface-variant leading-relaxed">{description}</p>
      <slot />
    </div>
  </div>
) : (
  <div class:list={['space-y-4', className]}>
    <div class="text-primary font-black text-7xl opacity-20 leading-none select-none" aria-hidden="true">{year}</div>
    <h3 class="text-2xl font-bold text-on-surface">{title}</h3>
    <p class="text-on-surface-variant leading-relaxed">{description}</p>
    <slot />
  </div>
)}
