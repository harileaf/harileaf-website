---
/**
 * SolutionCard — "Solutions in Action" section cards.
 *
 * From solutions page design:
 *   bg-surface-container-lowest p-8 rounded-xl group hover:shadow-xl transition-shadow
 *   Icon in colored container (rounded-lg bg-X/10)
 *   Title, description
 *   Optional metric at bottom (brand-gradient bar) or badge
 *
 * Props:
 *   icon        — Material Symbol name
 *   iconBg      — Tailwind bg class (default: 'bg-primary/10')
 *   iconColor   — Tailwind text class (default: 'text-primary')
 *   title       — card heading
 *   description — body text
 *   metric      — optional { label, value } shown as colored text
 *   showBar     — show brand-gradient bottom bar (default: false)
 *   class       — extra classes
 */
interface Metric { label: string; value: string }

interface Props {
  icon?: string;
  iconBg?: string;
  iconColor?: string;
  title: string;
  description: string;
  metric?: Metric;
  showBar?: boolean;
  class?: string;
}

const {
  icon,
  iconBg = 'bg-primary/10',
  iconColor = 'text-primary',
  title,
  description,
  metric,
  showBar = false,
  class: className = '',
} = Astro.props;
---

<div class:list={['bg-surface-container-lowest p-8 rounded-xl group hover:shadow-xl transition-shadow flex flex-col', className]}>
  {icon && (
    <div class:list={['w-12 h-12 rounded-lg flex items-center justify-center mb-6', iconBg]}>
      <span class:list={['material-symbols-outlined', iconColor]}>{icon}</span>
    </div>
  )}
  <h3 class="text-xl font-bold mb-4">{title}</h3>
  <p class="text-on-surface-variant mb-6 leading-relaxed">{description}</p>

  <slot />

  {metric && (
    <div class="mt-auto pt-4">
      <span class="text-sm font-bold text-secondary uppercase block mb-1">{metric.label}</span>
      <span class="text-2xl font-black text-primary">{metric.value}</span>
    </div>
  )}
  {showBar && (
    <div class="h-1 brand-gradient w-full rounded-full mt-auto"></div>
  )}
</div>
