---
/**
 * CTABanner — two CTA patterns from the designs.
 *
 * GRADIENT (homepage "Join the Agritech Revolution"):
 *   brand-gradient bg, rounded-2xl, text-center, white text
 *   Two buttons: dark primary + outline secondary (no email input)
 *   Decorative blur circles (bg-white/10 top-right, bg-black/10 bottom-left)
 *
 * DARK (contact / technology "Committed to…"):
 *   bg-on-surface (nearly black), white text
 *   Headline + description left, button(s) right
 *   Decorative eco icon top-right (opacity-10)
 *
 * Props:
 *   variant         — 'gradient' | 'dark'
 *   headline        — main heading
 *   body            — supporting text
 *   primaryLabel    — primary CTA button text
 *   primaryHref     — primary CTA href
 *   secondaryLabel  — secondary CTA button text (optional)
 *   secondaryHref   — secondary CTA href
 *   class           — extra classes
 */
interface Props {
  variant?: 'gradient' | 'dark';
  headline: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  class?: string;
}

const {
  variant = 'gradient',
  headline,
  body,
  primaryLabel,
  primaryHref = '#',
  secondaryLabel,
  secondaryHref = '#',
  class: className = '',
} = Astro.props;
---

{variant === 'gradient' ? (
  <div class:list={['rounded-2xl overflow-hidden relative p-12 md:p-16 text-center brand-gradient', className]}>
    <div class="relative z-10 max-w-2xl mx-auto space-y-6">
      <h2 class="text-3xl md:text-4xl font-black text-white">{headline}</h2>
      {body && <p class="text-white/90 text-lg leading-relaxed">{body}</p>}
      {(primaryLabel || secondaryLabel) && (
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-2">
          {primaryLabel && (
            <a
              href={primaryHref}
              class="bg-on-surface text-surface px-8 py-4 rounded-full font-bold hover:bg-on-surface/90 transition-colors active:scale-[0.98] whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {primaryLabel}
            </a>
          )}
          {secondaryLabel && (
            <a
              href={secondaryHref}
              class="border-2 border-white/60 text-white px-8 py-4 rounded-full font-bold hover:bg-white/10 transition-colors active:scale-[0.98] whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      )}
      <slot />
    </div>
    <!-- Decorative blur circles -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-black/10 rounded-full -ml-32 -mb-32 blur-3xl pointer-events-none" aria-hidden="true"></div>
  </div>
) : (
  <section class:list={['bg-on-surface text-white py-16 px-8 overflow-hidden relative', className]}>
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 relative z-10">
      <div class="flex-1">
        <h2 class="text-3xl font-bold tracking-tight">{headline}</h2>
        {body && <p class="text-white/60 mt-2 max-w-xl">{body}</p>}
        <slot />
      </div>
      {(primaryLabel || secondaryLabel) && (
        <div class="flex flex-wrap gap-4 shrink-0">
          {primaryLabel && (
            <a
              href={primaryHref}
              class="bg-white text-on-surface px-8 py-3 rounded-lg font-bold hover:bg-primary hover:text-white transition-colors whitespace-nowrap active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {primaryLabel}
            </a>
          )}
          {secondaryLabel && (
            <a
              href={secondaryHref}
              class="border-2 border-white/40 text-white px-8 py-3 rounded-lg font-bold hover:bg-white/10 transition-colors whitespace-nowrap active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      )}
    </div>
    <!-- Decorative eco icon -->
    <div class="absolute right-0 top-0 w-1/3 h-full opacity-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <span class="material-symbols-outlined text-[15rem] absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/4" style="font-variation-settings: 'FILL' 1;">eco</span>
    </div>
  </section>
)}
