---
/**
 * Hero — two patterns from the designs.
 *
 * PATTERN 'grid' (default — all inner pages + homepage):
 *   12-col grid, LEFT (7-col): PillBadge → h1 → description → CTAs
 *   RIGHT (5-col): image in rounded-xl with aspect-square, shadow-2xl,
 *     gradient-to-t overlay, optional floating data chip, decorative blur
 *   h1 highlight word rendered in text-primary (italic optional)
 *
 * PATTERN 'short' (Contact page):
 *   h-[450px], bg image full-cover, dark overlay from left
 *   White text: label → h1 → description
 *
 * Props (grid):
 *   badge         — { text, icon?, iconFill? } — PillBadge above heading
 *   headline      — main heading text (before highlight)
 *   highlightText — text rendered as text-primary (appended to headline)
 *   highlightItalic — wrap highlightText in <em> (default: false)
 *   description   — supporting paragraph
 *   image         — right-column image src
 *   imageAlt      — alt text
 *   ctaPrimary    — { label, href }
 *   ctaSecondary  — { label, href }
 *   floatingChip  — { value, label, icon? } — floating data card on image
 *
 * Props (short):
 *   label, labelColor, headline, highlightText, description, image, imageAlt,
 *   ctaPrimary, ctaSecondary
 */
import PillBadge from './PillBadge.astro';

interface Cta { label: string; href: string }
interface Badge { text: string; icon?: string; iconFill?: boolean }
interface FloatingChip { value: string; label: string; icon?: string }

interface Props {
  pattern?: 'grid' | 'short';
  badge?: Badge;
  label?: string;
  labelColor?: 'primary' | 'secondary' | 'tertiary' | 'white';
  headline: string;
  highlightText?: string;
  highlightItalic?: boolean;
  description?: string;
  subheadline?: string; // alias for description
  image?: string;
  imageAlt?: string;
  ctaPrimary?: Cta;
  ctaSecondary?: Cta;
  floatingChip?: FloatingChip;
  class?: string;
}

const {
  pattern = 'grid',
  badge,
  label,
  labelColor = 'primary',
  headline,
  highlightText,
  highlightItalic = false,
  description,
  subheadline,
  image,
  imageAlt = '',
  ctaPrimary,
  ctaSecondary,
  floatingChip,
  class: className = '',
} = Astro.props;

const body = description ?? subheadline;
---

{pattern === 'grid' ? (
  <section class:list={['relative pt-32 pb-20 px-6 overflow-hidden', className]}>
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left: text column -->
      <div class="lg:col-span-7 space-y-8">
        {badge && (
          <PillBadge text={badge.text} icon={badge.icon} iconFill={badge.iconFill} />
        )}
        {!badge && label && (
          <span class:list={[
            'block text-xs font-bold uppercase tracking-[0.2em]',
            `text-${labelColor}`,
          ]}>
            {label}
          </span>
        )}
        <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] text-on-surface">
          {headline}
          {highlightText && (
            <>
              {' '}
              {highlightItalic
                ? <em class="text-primary not-italic">{highlightText}</em>
                : <span class="text-primary">{highlightText}</span>}
            </>
          )}
        </h1>
        {body && (
          <p class="text-xl text-on-surface-variant max-w-lg leading-relaxed">{body}</p>
        )}
        {(ctaPrimary || ctaSecondary) && (
          <div class="flex flex-wrap items-center gap-4 pt-2">
            {ctaPrimary && (
              <a
                href={ctaPrimary.href}
                class="brand-gradient text-on-primary font-bold px-8 py-4 rounded-full shadow-lg hover:opacity-90 transition-opacity active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                {ctaPrimary.label}
              </a>
            )}
            {ctaSecondary && (
              <a
                href={ctaSecondary.href}
                class="bg-surface-container-highest text-primary font-bold px-8 py-4 rounded-full hover:bg-surface-container-high transition-colors active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                {ctaSecondary.label}
              </a>
            )}
          </div>
        )}
        <slot />
      </div>

      <!-- Right: image column -->
      <div class="lg:col-span-5 relative">
        {image && (
          <div class="relative aspect-square rounded-xl overflow-hidden shadow-2xl">
            <img
              src={image}
              alt={imageAlt}
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-on-surface/40 to-transparent"></div>
          </div>
        )}

        {/* Floating data chip */}
        {floatingChip && (
          <div class="absolute -bottom-6 -left-6 bg-surface-container-lowest p-5 rounded-xl shadow-xl z-10">
            <div class="flex items-center gap-3">
              {floatingChip.icon && (
                <div class="p-2 bg-primary-container rounded-full">
                  <span
                    class="material-symbols-outlined text-primary text-sm"
                    style="font-variation-settings: 'FILL' 1;"
                    aria-hidden="true"
                  >{floatingChip.icon}</span>
                </div>
              )}
              <div>
                <p class="text-xl font-black text-on-surface">{floatingChip.value}</p>
                <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">{floatingChip.label}</p>
              </div>
            </div>
          </div>
        )}

        {/* Decorative gradient blur */}
        <div
          class="absolute -z-10 -top-12 -right-12 w-64 h-64 brand-gradient opacity-20 rounded-full blur-3xl pointer-events-none"
          aria-hidden="true"
        ></div>
      </div>

    </div>
  </section>
) : (
  <!-- PATTERN 'short': inner-page full-width banner -->
  <section class:list={['relative h-[450px] w-full overflow-hidden', className]}>
    {image && (
      <div class="absolute inset-0 z-0">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-on-background/80 via-on-background/40 to-transparent"></div>
      </div>
    )}
    <div class="relative z-10 max-w-7xl mx-auto px-6 h-full flex flex-col justify-center">
      {label && (
        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-primary-container mb-4">
          {label}
        </span>
      )}
      <h1 class="text-5xl lg:text-7xl font-bold text-white tracking-tighter max-w-2xl leading-[1.1]">
        {headline}
        {highlightText && (
          <> <span class="text-brand-gradient">{highlightText}</span></>
        )}
      </h1>
      {body && (
        <p class="mt-6 text-white/80 text-lg max-w-lg leading-relaxed">{body}</p>
      )}
      {(ctaPrimary || ctaSecondary) && (
        <div class="flex flex-wrap gap-4 mt-8">
          {ctaPrimary && (
            <a
              href={ctaPrimary.href}
              class="brand-gradient text-white px-8 py-4 rounded-full font-bold shadow-lg hover:opacity-90 transition-opacity active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {ctaPrimary.label}
            </a>
          )}
          {ctaSecondary && (
            <a
              href={ctaSecondary.href}
              class="bg-white/10 text-white border border-white/30 px-8 py-4 rounded-full font-bold hover:bg-white/20 transition-colors active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {ctaSecondary.label}
            </a>
          )}
        </div>
      )}
      <slot />
    </div>
  </section>
)}
