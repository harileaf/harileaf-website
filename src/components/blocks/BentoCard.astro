---
/**
 * BentoCard — four variants from the technology/solutions/homepage bento grids.
 *
 * DEFAULT  — bg-surface-container-lowest, icon (optional bg container) + title + description
 *            Used for standard feature cells in technology/solutions pages
 *
 * GRADIENT — brand-gradient bg, text-on-primary, icon FILL 1, title + description
 *            Used for highlight cells (e.g. Neural Growth Engine)
 *
 * DARK-STAT — bg-[#2D312D] text-white, flex row: large stat + label LEFT, title + desc +
 *             progress bar RIGHT. Used for "98% Reduction" style cells.
 *
 * IMAGE-BG  — bg-surface-container-lowest with background image at ~10% opacity,
 *             gradient overlay, icon + title + description overlaid. Used for
 *             wide feature cards with imagery (e.g. Sensor Mesh 8-col).
 *
 * Props:
 *   variant        — 'default' | 'gradient' | 'dark-stat' | 'image-bg'
 *   title          — card heading
 *   description    — body text
 *   icon           — Material Symbol name
 *   iconFill       — fill the icon (default: false for default, true for gradient)
 *   iconBg         — bg class for icon container (default variant, default: 'bg-primary/10')
 *   iconColor      — text class for icon (default variant, default: 'text-primary')
 *   image          — background image (image-bg variant)
 *   imageAlt       — alt text
 *   statValue      — large stat number/text (dark-stat variant)
 *   statLabel      — label under the stat (dark-stat variant)
 *   progressPercent — 0–100 progress bar fill (dark-stat variant, optional)
 *   class          — extra classes (typically col-span)
 */
interface Props {
  variant?: 'default' | 'gradient' | 'dark-stat' | 'image-bg';
  title: string;
  description?: string;
  icon?: string;
  iconFill?: boolean;
  iconBg?: string;
  iconColor?: string;
  image?: string;
  imageAlt?: string;
  statValue?: string;
  statLabel?: string;
  progressPercent?: number;
  class?: string;
}

const {
  variant = 'default',
  title,
  description,
  icon,
  iconFill,
  iconBg = 'bg-primary/10',
  iconColor = 'text-primary',
  image,
  imageAlt = '',
  statValue,
  statLabel,
  progressPercent,
  class: className = '',
} = Astro.props;

// Fill defaults per variant
const fill = iconFill ?? (variant === 'gradient');
const fillStyle = fill
  ? "font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;"
  : "font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;";
---

{variant === 'default' && (
  <div class:list={['bg-surface-container-lowest p-8 rounded-xl flex flex-col gap-4 border border-outline-variant/15', className]}>
    {icon && (
      <div class:list={['w-12 h-12 rounded-lg flex items-center justify-center', iconBg]}>
        <span class:list={['material-symbols-outlined', iconColor]} style={fillStyle} aria-hidden="true">{icon}</span>
      </div>
    )}
    <h3 class="text-xl font-bold text-on-surface">{title}</h3>
    {description && <p class="text-on-surface-variant text-sm leading-relaxed">{description}</p>}
    <slot />
  </div>
)}

{variant === 'gradient' && (
  <div class:list={['brand-gradient p-8 rounded-xl flex flex-col justify-end gap-4 text-on-primary', className]}>
    {icon && (
      <span class="material-symbols-outlined text-4xl text-on-primary/90" style={fillStyle} aria-hidden="true">{icon}</span>
    )}
    <h3 class="text-xl font-bold">{title}</h3>
    {description && <p class="text-on-primary/80 text-sm leading-relaxed">{description}</p>}
    <slot />
  </div>
)}

{variant === 'dark-stat' && (
  <div class:list={['bg-[#2D312D] p-8 rounded-xl flex items-center gap-8 text-white', className]}>
    {(statValue || statLabel) && (
      <div class="shrink-0 text-center">
        <p class="text-5xl font-bold text-primary-container">{statValue}</p>
        {statLabel && <p class="text-xs font-bold uppercase tracking-widest text-white/60 mt-1 max-w-[100px]">{statLabel}</p>}
      </div>
    )}
    <div class="flex-1 space-y-3">
      <h3 class="text-xl font-bold">{title}</h3>
      {description && <p class="text-white/60 text-sm leading-relaxed">{description}</p>}
      {progressPercent !== undefined && (
        <div class="h-2 rounded-full bg-white/10 overflow-hidden mt-3">
          <div
            class="h-full brand-gradient rounded-full"
            style={`width: ${Math.min(100, Math.max(0, progressPercent))}%`}
          ></div>
        </div>
      )}
      <slot />
    </div>
  </div>
)}

{variant === 'image-bg' && (
  <div class:list={['relative overflow-hidden rounded-xl bg-surface-container-lowest p-8 flex flex-col justify-end group', className]}>
    {image && (
      <div class="absolute inset-0 z-0">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover opacity-10 group-hover:opacity-15 transition-opacity duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
      </div>
    )}
    <div class="relative z-10 space-y-3">
      {icon && (
        <span class:list={['material-symbols-outlined text-4xl block', iconColor]} style={fillStyle} aria-hidden="true">{icon}</span>
      )}
      <h3 class="text-xl font-bold text-on-surface">{title}</h3>
      {description && <p class="text-on-surface-variant text-sm leading-relaxed">{description}</p>}
      <slot />
    </div>
  </div>
)}
