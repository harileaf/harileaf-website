---
/**
 * JsonLd — renders a <script type="application/ld+json"> block.
 *
 * Place inside <head> (via BaseLayout's head slot).
 *
 * Supports any Schema.org type. Common usage:
 *
 * Organization (inject via SiteLayout for all pages — use orgSchema helper):
 *   <JsonLd type="Organization" data={orgData} />
 *
 * WebSite (homepage only):
 *   <JsonLd type="WebSite" data={{ name, url, potentialAction: { SearchAction } }} />
 *
 * BreadcrumbList (all inner pages):
 *   <JsonLd type="BreadcrumbList" data={{
 *     itemListElement: [
 *       { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://harileaf.ag/' },
 *       { '@type': 'ListItem', position: 2, name: 'Technology', item: 'https://harileaf.ag/technology' },
 *     ],
 *   }} />
 *
 * FAQPage:
 *   <JsonLd type="FAQPage" data={{
 *     mainEntity: [
 *       { '@type': 'Question', name: 'Q?', acceptedAnswer: { '@type': 'Answer', text: 'A.' } },
 *     ],
 *   }} />
 *
 * Props:
 *   type — Schema.org @type string
 *   data — schema properties (merged with @context and @type automatically)
 */
interface Props {
  type: string;
  data: Record<string, unknown>;
}

const { type, data } = Astro.props;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': type,
  ...data,
}, null, 0);
---

<script type="application/ld+json" is:inline set:html={schema}></script>
