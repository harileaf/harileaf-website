---
/**
 * Perishables only: where we deliver, how fast, which days we dispatch, and a
 * pincode check that answers in plain words (spec: v2 → Perishables).
 */
import type { StoreSettings } from '../../lib/store/settings';
import { WEEKDAY_NAMES, parseCalendar, type Zone } from '../../lib/store/zones';

interface Props {
  productName: string;
  zone: Zone;
  settings: StoreSettings;
}
const { productName, zone, settings } = Astro.props;
const cal = parseCalendar(settings);
const days = cal.days.map((d) => WEEKDAY_NAMES[d - 1].slice(0, 3));
const dayText = days.length > 1 ? `${days.slice(0, -1).join(', ')} and ${days[days.length - 1]}` : (days[0] ?? 'on set days');
const hour = cal.cutoffHour === 0 ? 'midnight' : cal.cutoffHour < 12 ? `${cal.cutoffHour} am` : cal.cutoffHour === 12 ? 'noon' : `${cal.cutoffHour - 12} pm`;
---

<div class="rounded-2xl border border-black/10 bg-white p-4 flex flex-col gap-3" data-zone-check={zone.id} data-product-name={productName}>
  <p class="text-sm">
    <strong>Delivered only within {zone.name}</strong>, by {zone.expressOnly ? 'express ' : ''}courier within {zone.maxTransitDays} day{zone.maxTransitDays === 1 ? '' : 's'} of dispatch, so it reaches you fresh.
    We dispatch on {dayText} (orders paid before {hour} go the same day). Prepaid only.
  </p>
  <form class="flex gap-2" novalidate>
    <label for={`zc-${zone.id}`} class="sr-only">Your pincode</label>
    <input id={`zc-${zone.id}`} name="pin" inputmode="numeric" maxlength="6" autocomplete="postal-code" placeholder="Your pincode"
      class="w-36 rounded-xl border border-black/15 bg-white px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-primary" />
    <button type="submit" class="rounded-full px-5 py-2.5 font-extrabold border-2 border-primary text-primary">Check delivery</button>
  </form>
  <p class="text-sm font-bold empty:hidden" aria-live="polite" data-zone-result></p>
</div>

<script>
  import { onEveryPage } from '../../scripts/page-load';

  const day = (ymd: string) => new Date(`${ymd}T00:00:00+05:30`).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });

  function initZoneCheck() {
    document.querySelectorAll<HTMLElement>('[data-zone-check]').forEach((box) => {
      const form = box.querySelector('form')!;
      const out = box.querySelector<HTMLElement>('[data-zone-result]')!;
      const say = (text: string, good: boolean) => {
        out.textContent = text;
        out.style.color = good ? '#1d7a3a' : '#8a4b00';
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pin = String(new FormData(form).get('pin') ?? '').replace(/\D/g, '');
        if (!/^[1-9]\d{5}$/.test(pin)) return say('Enter your 6-digit pincode.', false);
        say('Checking…', true);
        const res = await fetch(`/api/store/pincode?pin=${pin}&zone=${encodeURIComponent(box.dataset.zoneCheck!)}`).catch(() => null);
        const d = (await res?.json().catch(() => null)) as { zone?: { name: string; maxTransitDays: number; inZone: boolean; courier: boolean | null; dispatch: string | null; window: { from: string; to: string } | null } } | null;
        const z = d?.zone;
        const name = box.dataset.productName;
        if (!z) return say('We couldn’t check right now. Please try again, or check at checkout.', false);
        if (!z.inZone) return say(`Sorry — we send ${name} only within ${z.name} for now, so it can’t go to ${pin}.`, false);
        if (z.courier === false) return say(`Sorry — no courier can bring ${name} to ${pin} within ${z.maxTransitDays} days, so we can’t send it there.`, false);
        if (z.courier === null || !z.dispatch || !z.window) return say(`${pin} is in our ${z.name} delivery area. We’ll confirm the courier at checkout.`, true);
        say(`✓ Delivers to ${pin}: dispatched ${day(z.dispatch)}, arrives ${z.window.from === z.window.to ? day(z.window.to) : `${day(z.window.from)} – ${day(z.window.to)}`}.`, true);
      });
    });
  }
  onEveryPage(initZoneCheck);
</script>
