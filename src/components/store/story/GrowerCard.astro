---
/** One grower (dark card): photo, names, place, years on the land, a few lines (basic markdown, HTML escaped). */
import type { Grower } from '../../../lib/store/story';
import { renderBasicMarkdown } from '../../../lib/store/markdown';
import { mediaUrl } from '../../../lib/store/urls';
interface Props { grower: Grower }
const { grower: g } = Astro.props;
---
<div class="rounded-3xl p-7 border border-white/10 bg-white/[0.04] text-white">
  {g.photoKey && <img src={mediaUrl(g.photoKey)} alt={g.photoAlt} width="480" height="320" loading="lazy" decoding="async" class="w-full rounded-2xl object-cover aspect-[3/2] mb-4" />}
  <p class="text-xs uppercase tracking-widest font-extrabold" style="color:var(--accent,#9fb17d);">Grown by</p>
  <h3 class="mt-1 font-extrabold text-lg break-words">{g.names}</h3>
  <p class="text-sm" style="color:rgba(240,240,238,.7);">{g.place}{g.since ? ` · on this land since ${g.since}` : ''}</p>
  {g.bodyMd && <div class="mt-3 text-sm leading-relaxed [&_p]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_strong]:text-white" style="color:rgba(240,240,238,.75);" set:html={renderBasicMarkdown(g.bodyMd)} />}
</div>
