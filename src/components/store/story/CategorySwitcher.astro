---
/** Rice variety switcher: links to the other active products of the category. */
interface Props { current: { name: string; path: string }; others: Array<{ name: string; path: string }> }
const { current, others } = Astro.props;
---
{others.length > 0 && (
  <nav aria-label="Other varieties" class="mt-3 flex flex-wrap gap-2 text-xs">
    <span aria-current="page" class="rounded-full border-2 border-primary px-3 py-1 font-extrabold text-on-surface">{current.name}</span>
    {others.map((o) => <a href={o.path} class="rounded-full border border-black/15 px-3 py-1 font-bold text-on-surface hover:border-primary">{o.name}</a>)}
  </nav>
)}
