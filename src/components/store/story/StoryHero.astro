---
/**
 * Landing-page hero: eyebrow, two-line headline (the second in the accent),
 * subtitle, badges (the certification line as a green pill with its
 * certificate link, the GI badge, then plain lab values), CTA to the cards
 * and an optional photo. No
 * FadeIn: [data-animate] starts hidden until a script runs, and the H1 is
 * likely the page's largest content element.
 */
import type { StoryPage } from '../../../lib/store/story';
import { mediaUrl } from '../../../lib/store/urls';
interface Props {
  hero: Omit<StoryPage['hero'], 'proof'>;
  badges: string[];
  certLine?: string | null;
  certUrl?: string | null;
  giBadge?: string | null;
  ctaHref: string;
}
const { hero, badges, certLine = null, certUrl = null, giBadge = null, ctaHref } = Astro.props;
const hasBadges = Boolean(certLine || giBadge || badges.length);
// background-color stays when a browser can't parse color-mix() in the image layer.
const bg = 'background-color:#0c110c;background-image:radial-gradient(ellipse at 80% 0%, color-mix(in srgb, var(--accent,#9fb17d) 30%, transparent), transparent 60%), linear-gradient(135deg,#0e1a0e 0%,#0c110c 100%);padding:8rem 0 4.5rem;';
---
<section class="relative overflow-hidden text-white" style={bg}>
  <div class:list={['max-w-7xl mx-auto px-6 grid grid-cols-1 gap-10 items-center', { 'md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]': hero.photoKey }]}>
    <div>
      {hero.eyebrow && <p class="text-xs uppercase tracking-widest font-extrabold" style="color:var(--accent,#9fb17d);">{hero.eyebrow}</p>}
      <h1 class="text-white text-5xl md:text-6xl font-extrabold tracking-tighter leading-[1.05] mt-4 break-words">{hero.line1}{hero.line2 && <><br /><span style="color:var(--accent,#9fb17d);">{hero.line2}</span></>}</h1>
      {hero.subtitle && <p class="mt-5 text-lg max-w-xl leading-relaxed" style="color:rgba(255,255,255,.7);">{hero.subtitle}</p>}
      {hasBadges && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Highlights">
          {certLine && (
            <li class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-extrabold" style="background:rgba(120,170,90,.2);color:#cfe7b7;border:1px solid rgba(150,200,110,.5);">
              <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6" /></svg>
              <span>{certLine}{certUrl && <> · <a href={certUrl} class="underline" target="_blank" rel="noopener">View certificate</a></>}</span>
            </li>
          )}
          {giBadge && <li class="rounded-full px-3.5 py-1.5 text-xs font-extrabold" style="background:rgba(139,212,198,.15);color:#bfeee4;border:1px solid rgba(139,212,198,.5);">{giBadge}</li>}
          {badges.map((b) => <li class="rounded-full border border-white/20 bg-white/[0.06] px-3.5 py-1.5 text-xs font-bold">{b}</li>)}
        </ul>
      )}
      {hero.ctaLabel && <a href={ctaHref} class="mt-7 inline-block rounded-full px-6 py-3 font-extrabold text-[#1a1205] hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" style="background:var(--accent,#9fb17d);">{hero.ctaLabel} <span aria-hidden="true">↓</span></a>}
    </div>
    {hero.photoKey && <img src={mediaUrl(hero.photoKey)} alt={hero.photoAlt} width="900" height="700" fetchpriority="high" class="w-full rounded-3xl object-cover aspect-[9/7]" />}
  </div>
</section>
