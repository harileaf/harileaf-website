---
export const prerender = false;
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import SEO from '../components/seo/SEO.astro';
import ProductGrid from '../components/store/ProductGrid.astro';
import { listProducts, type ProductCard } from '../lib/store/catalog';
import { PAGE_CACHE_CONTROL } from '../lib/store/edge-cache';
import { breadcrumbJsonLd, jsonLdString } from '../lib/store/seo';
import { absolute } from '../lib/store/urls';

let cards: ProductCard[] = [];
try {
  cards = await listProducts(env.STORE_DB, { today: new Date() });
  Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
} catch (err) {
  // A 503 with Retry-After, not an empty 200 "first products are on their way" that a crawler could index.
  console.error(JSON.stringify({ msg: 'shop listing failed', error: String(err) }));
  return Astro.rewrite('/store-unavailable');
}

const categories = [
  { slug: 'rice', label: 'Rice' },
  { slug: 'spices', label: 'Spices' },
  { slug: 'produce', label: 'Fresh produce' },
].filter((c) => cards.some((p) => p.categorySlug === c.slug));

const claimChips = [...new Map(cards.flatMap((c) => c.claims).map((c) => [c.code, c.text])).entries()].slice(0, 8);

const title = 'Shop Heritage Rice & Stone-Ground Spices | HariLeaf';
const description = 'Buy HariLeaf heritage rice and stone-ground spices direct from the farm. Packed-on dates and lab reports on every batch, free delivery across India.';
---

<SiteLayout title={title} description={description}>
  <slot name="head" slot="head">
    <SEO title={title} description={description} canonicalUrl={absolute('/shop/')} />
    <script type="application/ld+json" is:inline set:html={jsonLdString(breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Shop', path: '/shop/' }]))} />
  </slot>

  <div class="max-w-7xl mx-auto px-6 pt-32 pb-24">
    <p class="text-xs uppercase tracking-widest font-extrabold text-secondary mb-2">HariLeaf Farm</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter text-on-surface">Shop the farm</h1>
    <p class="mt-3 text-lg text-on-surface-variant max-w-2xl">Heritage rice and slow, stone-ground spices — with the packed-on date and batch on every pack. Free delivery across India.</p>

    {cards.length === 0 ? (
      <p class="mt-12 text-on-surface-variant">Our first products are on their way. <a href="/contact" class="text-primary font-bold underline">Get in touch</a> to hear when they're live.</p>
    ) : (
      <>
        <div class="mt-10 flex flex-col gap-3" data-filters>
          {categories.length > 1 && (
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
              <button type="button" data-filter-cat="" aria-pressed="true" class="chip">All</button>
              {categories.map((c) => (<button type="button" data-filter-cat={c.slug} aria-pressed="false" class="chip">{c.label}</button>))}
            </div>
          )}
          {claimChips.length > 0 && (
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by process">
              {claimChips.map(([code, text]) => (<button type="button" data-filter-claim={code} aria-pressed="false" class="chip">{text}</button>))}
            </div>
          )}
          <p class="text-sm text-on-surface-variant" aria-live="polite" data-filter-count>{cards.length} product{cards.length === 1 ? '' : 's'}</p>
        </div>
        <div class="mt-6"><ProductGrid cards={cards} headingLevel="h2" /></div>
      </>
    )}
  </div>
</SiteLayout>

<style>
  .chip { border-radius: 9999px; padding: 0.45rem 1rem; font-size: 0.8125rem; font-weight: 700; border: 1.5px solid rgba(0, 0, 0, 0.12); background: #fff; color: #3f4946; }
  .chip[aria-pressed='true'] { background: #196a5e; border-color: #196a5e; color: #fff; }
  .chip:focus-visible { outline: 2px solid #196a5e; outline-offset: 2px; }
</style>

<script>
  import { onEveryPage } from '../scripts/page-load';

  // Re-run after view-transition navigations (bundled scripts execute once).
  onEveryPage(() => {
    const root = document.querySelector('[data-filters]');
    if (root) {
      let cat = '';
      const claims = new Set<string>();
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
      const count = document.querySelector<HTMLElement>('[data-filter-count]');
      const apply = () => {
        let shown = 0;
        for (const card of cards) {
          const codes = (card.dataset.claims ?? '').split(' ');
          const ok = (!cat || card.dataset.category === cat) && [...claims].every((c) => codes.includes(c));
          (card.closest('li') ?? card).toggleAttribute('hidden', !ok);
          if (ok) shown += 1;
        }
        if (count) count.textContent = `${shown} product${shown === 1 ? '' : 's'}`;
      };
      root.querySelectorAll<HTMLButtonElement>('[data-filter-cat]').forEach((b) =>
        b.addEventListener('click', () => {
          cat = b.dataset.filterCat ?? '';
          root.querySelectorAll('[data-filter-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          apply();
        }),
      );
      root.querySelectorAll<HTMLButtonElement>('[data-filter-claim]').forEach((b) =>
        b.addEventListener('click', () => {
          const code = b.dataset.filterClaim ?? '';
          if (claims.has(code)) claims.delete(code);
          else claims.add(code);
          b.setAttribute('aria-pressed', String(claims.has(code)));
          apply();
        }),
      );
    }
  });
</script>
