---
export const prerender = false;
import SiteLayout from '../../layouts/SiteLayout.astro';
import SEO from '../../components/seo/SEO.astro';

Astro.response.headers.set('Cache-Control', 'no-store');
// Also shown (with a 404) when an order link is missing or wrong — same page whether or not the order exists.
if (Astro.originPathname !== '/order/find' && Astro.originPathname !== '/order/find/') Astro.response.status = 404;
const fromPath = /^\/order\/(HL-\d{4}-\d{4,6})/.exec(Astro.originPathname)?.[1] ?? '';
const title = 'Find your order | HariLeaf';
---

<SiteLayout title={title} description="Get a fresh link to your HariLeaf order" noIndex>
  <slot name="head" slot="head"><SEO title={title} description="Get a fresh link to your HariLeaf order" noIndex /></slot>
  <div class="max-w-xl mx-auto px-6 pt-32 pb-24">
    <h1 class="text-4xl font-extrabold tracking-tight">Find your order</h1>
    <p class="mt-2 text-on-surface-variant">{fromPath ? 'That order link is incomplete or has expired. ' : ''}Enter your order number and the email you used, and we'll email you a fresh link.</p>
    <form id="find-form" class="mt-8 flex flex-col gap-4" novalidate>
      <div>
        <label class="block text-sm font-bold mb-1" for="f-no">Order number</label>
        <input id="f-no" name="orderNo" value={fromPath} placeholder="HL-2610-0001" required autocomplete="off" class="w-full rounded-xl border border-black/15 px-4 py-3" />
      </div>
      <div>
        <label class="block text-sm font-bold mb-1" for="f-email">Email</label>
        <input id="f-email" name="email" type="email" required autocomplete="email" class="w-full rounded-xl border border-black/15 px-4 py-3" />
      </div>
      <button class="rounded-full px-7 py-3 font-extrabold text-white self-start" style="background:linear-gradient(135deg,#196a5e,#2d7a4f)">Email me the link</button>
      <p id="find-status" role="status" aria-live="polite" class="font-bold"></p>
    </form>
  </div>
</SiteLayout>

<script>
  const form = document.getElementById('find-form') as HTMLFormElement;
  const out = document.getElementById('find-status')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    try {
      const res = await fetch('/api/store/order/resend', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderNo: String(fd.get('orderNo') ?? ''), email: String(fd.get('email') ?? '') }) });
      const data = (await res.json().catch(() => ({}))) as { message?: string; error?: string };
      out.textContent = data.message ?? data.error ?? 'Something went wrong — please try again.';
    } catch {
      out.textContent = 'Network error — please try again.';
    }
    btn.disabled = false;
  });
</script>
