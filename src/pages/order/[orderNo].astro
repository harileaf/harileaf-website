---
export const prerender = false;
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import { formatINR } from '../../lib/store/money';
import { getOrderByNo } from '../../lib/store/orders';
import { checkViewToken } from '../../lib/store/tokens';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
// The URL carries a secret token: never leak it to other sites.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const token = Astro.url.searchParams.get('t') ?? '';
const view = await getOrderByNo(env.STORE_DB, Astro.params.orderNo ?? '');
const allowed = Boolean(view && env.ORDER_TOKEN_SECRET && (await checkViewToken(env.ORDER_TOKEN_SECRET, token, view.order.view_token_hash)));
if (!allowed) return Astro.rewrite('/404');
const { order: o, items, holdExpiresAt } = view!;

const STATUS: Record<string, { title: string; body: string }> = {
  pending_payment: { title: 'Waiting for payment', body: 'Your items are held for you. Complete the payment to place the order.' },
  payment_failed: { title: 'Payment not completed', body: 'We didn’t receive a payment in time, so the items were released. You haven’t been charged. You can place a new order any time.' },
  placed: { title: 'Order confirmed', body: 'Thank you! We’ll pack it within 2 business days and email you a tracking link when it ships.' },
  packed: { title: 'Packed', body: 'Your order is packed and waiting for the courier.' },
  shipped: { title: 'On the way', body: 'Your order has left our farm.' },
  delivered: { title: 'Delivered', body: 'Your order has been delivered. Enjoy!' },
  cancelled: { title: 'Cancelled', body: 'This order was cancelled.' },
  rto: { title: 'Returning to us', body: 'The courier couldn’t deliver this order and it is coming back to us. We’ll be in touch.' },
  returned: { title: 'Returned', body: 'This order was returned.' },
};
const s = STATUS[o.status] ?? { title: o.status, body: '' };
const canPay = o.status === 'pending_payment' && o.payment_method === 'razorpay' && Boolean(holdExpiresAt && holdExpiresAt > new Date().toISOString());
const fmt = (iso: string) => new Date(iso).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' });
const tax = items.reduce((a, i) => ({ cgst: a.cgst + i.cgst_paise, sgst: a.sgst + i.sgst_paise, igst: a.igst + i.igst_paise }), { cgst: 0, sgst: 0, igst: 0 });
const paymentLine =
  o.payment_method === 'cod'
    ? `Cash on delivery — ${formatINR(o.total_paise)} to pay on delivery`
    : o.payment_status === 'paid' || o.payment_status === 'authorized'
      ? `Paid online${o.paid_at ? ` on ${fmt(o.paid_at)}` : ''}`
      : o.payment_status === 'refunded' ? 'Refunded' : 'Online payment';
---

<SiteLayout title={`Order ${o.order_no} | HariLeaf`} description="Your HariLeaf order" noIndex>
  <slot name="head" slot="head"><SEO title={`Order ${o.order_no} | HariLeaf`} description="Your HariLeaf order" noIndex /></slot>
  <div class="max-w-4xl mx-auto px-6 pt-32 pb-24">
    <p class="text-sm text-on-surface-variant">Order {o.order_no} · placed {fmt(o.created_at)}</p>
    <h1 class="text-4xl font-extrabold tracking-tight mt-1">{s.title}</h1>
    <p class="mt-2 text-on-surface-variant max-w-2xl">{s.body}</p>

    {canPay && (
      <div class="mt-6 rounded-2xl p-5 flex flex-wrap items-center gap-4" style="background:#eef8f5;border:1px solid #8bd4c6">
        <p class="flex-1 min-w-[14rem] text-sm">Your items are held until <strong>{fmt(holdExpiresAt!)}</strong>.</p>
        <button id="pay-now" type="button" data-order={o.order_no} data-token={token} class="rounded-full px-7 py-3 font-extrabold text-white" style="background:linear-gradient(135deg,#196a5e,#2d7a4f)">Pay {formatINR(o.total_paise)} now</button>
        <p id="pay-status" class="w-full text-sm font-bold" role="status" aria-live="polite"></p>
      </div>
    )}
    {o.tracking_url && <p class="mt-6"><a href={o.tracking_url} class="font-extrabold text-primary underline" rel="noopener noreferrer" target="_blank">Track your parcel{o.courier ? ` (${o.courier})` : ''} →</a></p>}

    <div class="mt-10 grid md:grid-cols-[1.4fr_1fr] gap-8 items-start">
      <section aria-labelledby="items-h" class="rounded-2xl bg-white border border-black/5 p-6">
        <h2 id="items-h" class="text-lg font-extrabold mb-4">Items</h2>
        <ul class="flex flex-col gap-3">
          {items.map((i) => (
            <li class="flex justify-between gap-4 text-sm">
              <span><strong>{i.product_name}</strong> · {i.variant_label} × {i.qty}<span class="block text-xs text-on-surface-variant">{formatINR(i.unit_price_paise)} each · GST {i.gst_rate_bp / 100}%</span></span>
              <span class="font-bold whitespace-nowrap">{formatINR(i.line_total_paise)}</span>
            </li>
          ))}
        </ul>
        <div class="border-t border-black/10 mt-4 pt-3 text-sm flex flex-col gap-1">
          <p class="flex justify-between"><span>Delivery</span><span>Free</span></p>
          {tax.igst > 0 ? <p class="flex justify-between text-on-surface-variant"><span>includes IGST</span><span>{formatINR(tax.igst)}</span></p> : <p class="flex justify-between text-on-surface-variant"><span>includes CGST + SGST</span><span>{formatINR(tax.cgst)} + {formatINR(tax.sgst)}</span></p>}
          <p class="flex justify-between text-lg font-extrabold mt-1"><span>Total</span><span>{formatINR(o.total_paise)}</span></p>
        </div>
      </section>
      <section class="flex flex-col gap-4 text-sm">
        <div class="rounded-2xl bg-surface-container-low p-5">
          <h2 class="font-extrabold mb-1">Delivering to</h2>
          <p>{o.customer_name}<br />{o.ship_line1}{o.ship_line2 ? <><br />{o.ship_line2}</> : null}<br />{o.ship_city}, {o.ship_state} {o.ship_pincode}<br />{o.phone}</p>
        </div>
        <div class="rounded-2xl bg-surface-container-low p-5">
          <h2 class="font-extrabold mb-1">Payment</h2>
          <p>{paymentLine}</p>
          <p class="mt-2 text-xs text-on-surface-variant">Your GST invoice is issued when the order ships.</p>
        </div>
        <p class="text-on-surface-variant">Questions? See our <a href="/refund-policy" class="underline">refund policy</a> or <a href="/grievance" class="underline">contact customer care</a> with your order number.</p>
      </section>
    </div>
  </div>
</SiteLayout>

<script>
  import { onEveryPage } from '../../scripts/page-load';
  import { payForOrder } from '../../scripts/store/razorpay-checkout';

  // With view transitions this script runs once per visit, so set the page up on every page load.
  function initOrderPage() {
    // The ?t= token stays in the address bar so refresh, bookmarks and Back keep working; the page
    // is no-referrer, noindex and no-store, so the link isn't leaked to other sites or caches.
    const reloadOrder = () => location.reload();

    const btn = document.getElementById('pay-now') as HTMLButtonElement | null;
    const status = document.getElementById('pay-status');
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      if (status) status.textContent = 'Opening payment…';
      const res = await fetch('/api/store/order/retry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderNo: btn.dataset.order, token: btn.dataset.token }) });
      const data = (await res.json().catch(() => ({}))) as { payment?: Record<string, unknown>; error?: string; status?: string };
      if (res.ok && data.status === 'placed') {
        reloadOrder(); // a payment had already gone through
        return;
      }
      if (!res.ok || !data.payment) {
        if (status) status.textContent = data.error ?? 'Payment can’t be opened right now.';
        btn.disabled = false;
        return;
      }
      try {
        const outcome = await payForOrder(data.payment, { orderNo: btn.dataset.order!, token: btn.dataset.token! });
        if (outcome.kind === 'paid') reloadOrder();
        else if (status) status.textContent = outcome.kind === 'dismissed' ? 'Payment not completed.' : outcome.message;
      } catch (err) {
        if (status) status.textContent = err instanceof Error ? err.message : 'Payment can’t be opened right now.';
      }
      btn.disabled = false;
    });
  }
  onEveryPage(initOrderPage);
</script>
