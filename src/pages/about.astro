---
export const prerender = true;
import SiteLayout from '../layouts/SiteLayout.astro';
import FadeIn from '../components/animations/FadeIn.astro';
import StaggerChildren from '../components/animations/StaggerChildren.astro';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import aboutJson from '../content/about-page.json';

// ── CMS data ──────────────────────────────────────────────────────────────────
const page    = aboutJson;
const hero    = page.hero;
const mission = page.mission;
const vision  = page.vision;
const values       = page.values;
const partnerships = page.partnerships;
const cta          = page.cta;
const seo     = page.seo;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://harileaf.ag');
const pageTitle    = seo?.metaTitle    ?? 'About Us | HariLeaf Agritech — Cultivating a Sustainable Legacy';
const pageDesc     = seo?.metaDescription ?? 'HariLeaf Agritech was born from a singular vision: to bridge the gap between ancient agricultural wisdom and the precision of modern technology.';
---

<SiteLayout
  title={pageTitle}
  description={pageDesc}
  noIndex={seo?.noIndex ?? false}
  headerCtaVariant="container"
  headerLogoSize="md"
>
  <slot name="head" slot="head">
    <SEO title={pageTitle} description={pageDesc} canonicalUrl={canonicalURL} />
    <JsonLd
      type="BreadcrumbList"
      data={{
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://harileaf.ag/' },
          { '@type': 'ListItem', position: 2, name: 'About', item: 'https://harileaf.ag/about' },
        ],
      }}
    />
  </slot>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
       ═══════════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-8 grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Text -->
      <div class="z-10">
        <FadeIn>
          <span class="inline-block px-4 py-1 rounded-full bg-secondary-container text-on-secondary-container text-sm font-bold tracking-widest uppercase mb-6">
            {hero.badge}
          </span>
        </FadeIn>
        <FadeIn delay={100}>
          <h1 class="text-6xl font-extrabold leading-[1.1] text-on-surface mb-8 tracking-tighter">
            {hero.headline} <span class="text-primary">{hero.headlineHighlight}</span> {hero.headlineSuffix}
          </h1>
        </FadeIn>
        <FadeIn delay={200}>
          <p class="text-xl text-on-surface-variant leading-relaxed mb-10 max-w-xl">
            {hero.description}
          </p>
        </FadeIn>
      </div>

      <!-- Right: Image + floating stat -->
      <FadeIn direction="right" class="relative">
        <div class="aspect-[4/5] rounded-xl overflow-hidden shadow-2xl">
          <img
            src={hero.image}
            alt="Futuristic indoor hydroponic farm with vibrant green leafy vegetables glowing under soft LED lights"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-8 -left-8 bg-surface-container-lowest p-8 rounded-lg shadow-xl max-w-xs">
          <p class="text-primary font-bold text-4xl mb-1">{hero.stat.value}</p>
          <p class="text-sm font-label uppercase tracking-widest text-on-surface-variant">{hero.stat.label}</p>
        </div>
      </FadeIn>

    </div>
  </header>


  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — MISSION & VISION (Bento Grid)
       ═══════════════════════════════════════════════════ -->
  <section class="py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

        <!-- Row 1: Mission card (7-col) -->
        <FadeIn class="md:col-span-7">
          <div class="bg-surface-container-lowest p-12 rounded-xl flex flex-col justify-between h-full">
            <div>
              <div class="w-12 h-12 brand-gradient rounded-lg flex items-center justify-center mb-8">
                <span class="material-symbols-outlined text-white" aria-hidden="true">{mission.icon}</span>
              </div>
              <h2 class="text-3xl font-bold mb-6">{mission.title}</h2>
              <p class="text-lg text-on-surface-variant leading-relaxed">
                {mission.body}
              </p>
            </div>
          </div>
        </FadeIn>

        <!-- Row 1: Mission image (5-col) -->
        <FadeIn delay={100} class="md:col-span-5">
          <div class="rounded-xl overflow-hidden h-full min-h-[300px]">
            <img
              src={mission.image}
              alt={mission.imageAlt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </FadeIn>

        <!-- Row 2: Vision image (4-col) -->
        <FadeIn class="md:col-span-4">
          <div class="rounded-xl overflow-hidden h-full min-h-[280px]">
            <img
              src={vision.image}
              alt={vision.imageAlt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </FadeIn>

        <!-- Row 2: Vision card (8-col) -->
        <FadeIn delay={100} class="md:col-span-8">
          <div class="bg-primary text-white p-12 rounded-xl flex flex-col justify-center h-full">
            <h2 class="text-3xl font-bold mb-6">{vision.title}</h2>
            <p class="text-xl font-light leading-relaxed opacity-90">
              {vision.body}
            </p>
            <div class="mt-8 flex gap-4 flex-wrap">
              {vision.pills.map((pill: string) => (
                <span class="px-4 py-2 bg-white/10 rounded-full text-sm">{pill}</span>
              ))}
            </div>
          </div>
        </FadeIn>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — CORE VALUES ("What Guides Us")
       ═══════════════════════════════════════════════════ -->
  <section class="py-24 bg-surface-container-high">
    <div class="max-w-7xl mx-auto px-8 text-center mb-16">
      <FadeIn>
        <h2 class="text-4xl font-bold">{values.title}</h2>
      </FadeIn>
    </div>
    <StaggerChildren class="max-w-7xl mx-auto px-8 grid md:grid-cols-3 gap-8">
      {values.items.map((item: { icon: string; title: string; description: string }) => (
        <div class="bg-surface-container-lowest p-10 rounded-xl">
          <span
            class="material-symbols-outlined text-primary text-4xl mb-6 block"
            style="font-variation-settings:'FILL' 1"
            aria-hidden="true"
          >{item.icon}</span>
          <h4 class="text-xl font-bold mb-4">{item.title}</h4>
          <p class="text-on-surface-variant">{item.description}</p>
        </div>
      ))}
    </StaggerChildren>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — PARTNERSHIPS / TIE-UPS
       ═══════════════════════════════════════════════════ -->
  <section class="py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-8">

      <FadeIn>
        <div class="text-center mb-16">
          <span class="text-xs uppercase tracking-widest text-secondary font-bold">{partnerships.label}</span>
          <h2 class="text-4xl font-extrabold mt-4 tracking-tight">{partnerships.title}</h2>
          <p class="text-on-surface-variant mt-4 max-w-2xl mx-auto">{partnerships.description}</p>
        </div>
      </FadeIn>

      <StaggerChildren class="flex flex-wrap justify-center gap-4">
        {partnerships.partners.map((partner: { name: string; category: string; color: string; logo: string }) => (
          <div class="flex items-center gap-3 bg-surface-container-lowest border border-outline-variant/15 rounded-full px-5 py-3 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-default">
            <!-- Logo or coloured initial -->
            {partner.logo ? (
              <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden bg-white p-1">
                <img src={partner.logo} alt={partner.name} class="w-full h-full object-contain" loading="lazy" />
              </div>
            ) : (
              <span
                class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-black flex-shrink-0"
                style={`background-color: ${partner.color};`}
                aria-hidden="true"
              >
                {partner.name.charAt(0)}
              </span>
            )}
            <div>
              <p class="font-bold text-sm text-on-surface leading-none">{partner.name}</p>
              <p class="text-xs text-on-surface-variant mt-0.5">{partner.category}</p>
            </div>
          </div>
        ))}
      </StaggerChildren>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 5 — INSTAGRAM FEED
       ═══════════════════════════════════════════════════ -->
  <section class="py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-8">
      <FadeIn>
        <div class="text-center mb-12">
          <span class="text-xs uppercase tracking-widest text-secondary font-bold">From the Field</span>
          <h2 class="text-4xl font-extrabold mt-4 tracking-tight">Follow the harvest.</h2>
          <p class="text-on-surface-variant mt-4 max-w-xl mx-auto">
            Real soil, real growth, real results — follow us on Instagram for a ground-level view of what we're building.
          </p>
          <a
            href="https://instagram.com/harileafagritech"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 mt-6 text-sm font-bold text-primary hover:underline underline-offset-4 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            @harileafagritech
          </a>
        </div>
      </FadeIn>

      <!-- Behold Instagram embed — replace FmJ8ioTyA5WL2pPIhczq with your Behold widget ID from behold.so -->
      <div id="behold-instagram-feed">
        <behold-widget feed-id="FmJ8ioTyA5WL2pPIhczq"></behold-widget>
      </div>
      <script type="module" src="https://w.behold.so/widget.js"></script>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 6 — CTA (Gradient Banner)
       ═══════════════════════════════════════════════════ -->
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-8">
      <FadeIn>
        <div class="brand-gradient rounded-[2rem] p-16 text-center text-on-primary">
          <h2 class="text-4xl font-extrabold mb-6">{cta.headline}</h2>
          <p class="text-xl mb-10 opacity-90 max-w-2xl mx-auto">{cta.body}</p>
          <div class="flex justify-center gap-6 flex-wrap">
            <a
              href={cta.primaryButton.url}
              class="bg-on-surface text-surface px-8 py-4 rounded-full font-bold hover:scale-105 transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {cta.primaryButton.label}
            </a>
            <a
              href={cta.secondaryButton.url}
              class="border-2 border-on-primary text-on-primary px-8 py-4 rounded-full font-bold hover:bg-on-primary hover:text-primary transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              {cta.secondaryButton.label}
            </a>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

</SiteLayout>
