---
export const prerender = true;
import SiteLayout from '../../layouts/SiteLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import { RECIPES } from '../../content/store/recipes';
import { absolute } from '../../lib/store/urls';

const title = 'Recipes with heritage rice and stone-ground spices | HariLeaf';
const description = 'Everyday Indian recipes made with HariLeaf heritage rice and stone-ground spices — khichdi, red rice pulao, haldi doodh and more.';
---

<SiteLayout title={title} description={description}>
  <slot name="head" slot="head"><SEO title={title} description={description} canonicalUrl={absolute('/recipes/')} /></slot>
  <div class="max-w-7xl mx-auto px-6 pt-32 pb-24">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter">Recipes</h1>
    <p class="mt-3 text-lg text-on-surface-variant max-w-2xl">Simple, everyday cooking with our rice and spices.</p>
    <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
      {RECIPES.map((r) => (
        <li>
          <a href={`/recipes/${r.slug}/`} class="block rounded-2xl overflow-hidden bg-white border border-black/5 hover:-translate-y-1 transition-transform">
            <img src={r.image} alt={r.imageAlt} width="600" height="450" loading="lazy" class="w-full aspect-[4/3] object-cover" />
            <div class="p-5">
              <h2 class="font-extrabold text-lg">{r.title}</h2>
              <p class="mt-1 text-sm text-on-surface-variant">{r.summary}</p>
              <p class="mt-2 text-xs text-on-surface-variant">{r.prepMinutes + r.cookMinutes} min · Serves {r.serves}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</SiteLayout>
