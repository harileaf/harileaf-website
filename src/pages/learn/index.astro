---
export const prerender = true;
import SiteLayout from '../../layouts/SiteLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import { ARTICLES } from '../../content/store/articles';
import { breadcrumbJsonLd, itemListJsonLd, jsonLdString } from '../../lib/store/seo';
import { absolute } from '../../lib/store/urls';

const title = 'Guides to heritage rice, turmeric and mangoes | HariLeaf';
const description = 'Plain-language guides to how rice is milled, turmeric is cured and ground, and mangoes are ripened — and how HariLeaf grows its own.';
---

<SiteLayout title={title} description={description}>
  <slot name="head" slot="head">
    <SEO title={title} description={description} canonicalUrl={absolute('/learn/')} />
    <script type="application/ld+json" is:inline set:html={jsonLdString(breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Learn', path: '/learn/' }]))} />
    <script type="application/ld+json" is:inline set:html={jsonLdString(itemListJsonLd(ARTICLES.map((a) => ({ name: a.title, path: `/learn/${a.slug}/` }))))} />
  </slot>
  <div class="max-w-5xl mx-auto px-6 pt-32 pb-24">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter">Learn</h1>
    <p class="mt-3 text-lg text-on-surface-variant max-w-2xl">What happens to rice, spices and fruit between the field and your kitchen.</p>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-5" role="list">
      {ARTICLES.map((a) => (
        <li>
          <a href={`/learn/${a.slug}/`} class="block h-full rounded-2xl bg-white border border-black/5 p-6 hover:-translate-y-1 transition-transform">
            <h2 class="font-extrabold text-xl">{a.title}</h2>
            <p class="mt-2 text-sm text-on-surface-variant">{a.summary}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-sm"><a href="/recipes/" class="font-bold text-primary underline">Recipes</a> · <a href="/our-process/" class="font-bold text-primary underline">How we grow, mill and grind</a> · <a href="/shop/" class="font-bold text-primary underline">Shop</a></p>
  </div>
</SiteLayout>
