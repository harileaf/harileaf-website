---
export const prerender = false;
import { env } from 'cloudflare:workers';
import ProductEditor, { type EditorProduct, type EditorVariant } from '../../../components/admin/ProductEditor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { validateSession } from '../../../lib/auth';
import { getProductForAdmin, listProductsForAdmin, shelfLifeWarning } from '../../../lib/store/catalog-admin';
import { editorMedia } from '../../../lib/store/editor-media';
import { mediaUrl } from '../../../lib/store/urls';
import { loadZones } from '../../../lib/store/catalog';

const authenticated = await validateSession(env.HARILEAF_CMS, Astro.cookies);
const isNew = Astro.params.id === 'new';
const id = isNew ? null : Number(Astro.params.id);

const blank: EditorProduct = {
  categorySlug: 'rice', slug: '', name: '', shortDescription: '', descriptionMd: '', status: 'draft', replacementProductId: null,
  organicScheme: 'none', organicConversionSince: null, organicCertNumber: null, giName: null, giAuRegNumber: null, processClaims: [], howItsMade: {}, harvestInfo: {},
  attributes: {}, faq: [], bestBeforeDays: null, storageInstructions: '', countryOfOrigin: 'India', ingredients: '', allergenInfo: null,
  vegMark: true, nutrition: { per: '100 g', source: null, rows: [] }, hsnCode: '', gstRateBp: 500, perishable: false, deliveryZoneId: null, codAllowed: true,
  seasonStartMd: null, seasonEndMd: null, offSeasonMode: null, preorderDispatchDate: null, seoTitle: null, seoDescription: null, relatedProductIds: [],
};

let props: Parameters<typeof ProductEditor>[0] | null = null;
let notFound = false;
if (authenticated) {
  const all = await listProductsForAdmin(env.STORE_DB);
  const others = all.filter((r) => r.id !== id).map((r) => ({ id: r.id, name: `${r.name} (/${r.categorySlug}/${r.slug})` }));
  const zones = (await loadZones(env.STORE_DB)).map((z) => ({ id: z.id, name: z.name, enabled: z.enabled }));
  if (isNew) {
    props = { id: null, initial: blank, variants: [], images: [], batches: [], labReports: [], certUrl: null, publishedAt: null, others, shelfWarning: null, zones };
  } else if (Number.isInteger(id)) {
    const a = await getProductForAdmin(env.STORE_DB, id as number);
    if (!a) notFound = true;
    else {
      const p = a.product;
      const activeBatch = a.batches.find((b) => b.active === 1);
      props = {
        id: p.id,
        initial: {
          categorySlug: p.category.slug, slug: p.slug, name: p.name, shortDescription: p.shortDescription, descriptionMd: p.descriptionMd,
          status: p.status, replacementProductId: a.replacementProductId, organicScheme: p.organic.scheme,
          organicConversionSince: p.organic.conversionSince, organicCertNumber: p.organic.certNumber, giName: p.gi.name, giAuRegNumber: p.gi.auRegNumber, processClaims: p.claims,
          howItsMade: p.howItsMade, harvestInfo: p.harvestInfo, attributes: p.attributes, faq: p.faq,
          bestBeforeDays: p.listing.bestBeforeDays, storageInstructions: p.listing.storage, countryOfOrigin: p.listing.countryOfOrigin,
          ingredients: p.listing.ingredients, allergenInfo: p.listing.allergens, vegMark: p.listing.veg, nutrition: p.nutrition,
          hsnCode: p.hsnCode, gstRateBp: p.gstRateBp, perishable: p.perishable, deliveryZoneId: p.deliveryZoneId, codAllowed: p.codAllowed,
          seasonStartMd: p.season.startMd, seasonEndMd: p.season.endMd, offSeasonMode: p.season.offSeasonMode,
          preorderDispatchDate: p.season.preorderDispatchDate, seoTitle: p.seoTitle, seoDescription: p.seoDescription, relatedProductIds: p.relatedIds,
        },
        variants: a.variants.map((v): EditorVariant => ({
          id: v.id, sku: v.sku, label: v.label, netQtyLabel: v.net_qty_label, unitQtyG: v.unit_qty_g, pricePaise: v.price_paise,
          mrpPaise: v.mrp_paise, weightG: v.weight_g, lengthCm: v.length_cm, breadthCm: v.breadth_cm, heightCm: v.height_cm,
          stockAdjust: 0, currentStock: v.stock_qty, lowStockThreshold: v.low_stock_threshold, active: v.active === 1, sort: v.sort,
        })),
        ...editorMedia(a),
        certUrl: a.certKey ? mediaUrl(a.certKey) : null,
        publishedAt: a.publishedAt,
        others,
        zones,
        shelfWarning: shelfLifeWarning(activeBatch?.packed_on ?? null, p.listing.bestBeforeDays, new Date()),
      };
    }
  } else notFound = true;
}
if (notFound) Astro.response.status = 404;
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={isNew ? 'New product' : (props?.initial.name || 'Product')} active="products">
  <p style="margin-bottom:1rem;"><a href="/admin/products" style="color:#196a5e;font-weight:700;">← All products</a></p>
  {saved && <p class="warn" style="background:#e8f5f3;border-color:#8bd4c6;color:#196a5e;" role="status">✓ Saved. Live pages refresh within a minute.</p>}
  {notFound && <p class="warn">Product not found.</p>}
  {props && <ProductEditor client:load {...props} />}
</AdminLayout>
