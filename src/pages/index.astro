---
export const prerender = true;
import SiteLayout from '../layouts/SiteLayout.astro';
import FadeIn from '../components/animations/FadeIn.astro';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import homepageJson from '../content/homepage.json';
import siteJson from '../content/site-settings.json';

// ── CMS data ──────────────────────────────────────────────────────────────────
const page = homepageJson;
const site = siteJson;

const hero         = page.hero;
const bento        = page.bentoSection;
const editorial    = page.editorialSection;
const intelligence = page.intelligenceSection;
const cta          = page.ctaSection;
const seo          = page.seo;

const siteName     = site.title ?? 'HariLeaf Agritech';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://harileaf.ag');
const pageTitle    = seo?.metaTitle    ?? 'HariLeaf Agritech | Open-field farming reimagined';
const pageDesc     = seo?.metaDescription ?? (site.description ?? 'Sustainable intelligence for the modern grower.');
---

<SiteLayout title={pageTitle} description={pageDesc} noIndex={seo?.noIndex ?? false}>

  <slot name="head" slot="head">
    <SEO
      title={pageTitle}
      description={pageDesc}
      canonicalUrl={canonicalURL}
      ogImage={site.defaultOgImage ? new URL(site.defaultOgImage, canonicalURL) : undefined}
      noIndex={seo?.noIndex ?? false}
    />
    <JsonLd
      type="WebSite"
      data={{
        name: siteName,
        url: String(canonicalURL.origin),
        description: pageDesc,
        potentialAction: {
          '@type': 'SearchAction',
          target: `${canonicalURL.origin}/?s={search_term_string}`,
          'query-input': 'required name=search_term_string',
        },
      }}
    />
  </slot>


  <!-- ══════════════════════════════════════════════════════════════
       SECTION 1 — HERO (Full-screen background image)
       ══════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden">

    <!-- Background image + gradient overlay -->
    <div class="absolute inset-0 z-0">
      {hero.image ? (
        <img
          src={hero.image}
          alt="Open-field farming reimagined — HariLeaf"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="w-full h-full brand-gradient opacity-40"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/40 to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 w-full">
      <div class="space-y-8">

        <FadeIn>
          <span class="text-xs uppercase tracking-widest text-primary font-bold">
            {hero.label}
          </span>
        </FadeIn>

        <FadeIn delay={100}>
          <h1 class="text-6xl md:text-7xl font-extrabold text-on-surface leading-[1.1] tracking-tighter">
            {hero.headline}<br />
            <span class="text-primary italic">{hero.highlightText}</span>.
          </h1>
        </FadeIn>

        <FadeIn delay={200}>
          <p class="text-xl text-on-surface-variant max-w-lg leading-relaxed">
            {hero.description}
          </p>
        </FadeIn>

        <FadeIn delay={300}>
          <div class="flex items-center gap-4 flex-wrap">
            <a
              href={hero.ctaPrimary.url}
              class="brand-gradient text-white px-8 py-4 rounded-full font-bold shadow-lg hover:opacity-90 transition-opacity active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {hero.ctaPrimary.label}
            </a>
            <a
              href={hero.ctaSecondary.url}
              class="bg-surface-container-highest text-primary px-8 py-4 rounded-full font-bold hover:bg-surface-container-high transition-colors active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {hero.ctaSecondary.label}
            </a>
          </div>
        </FadeIn>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════
       SECTION 2 — PRECISION FIELD TECHNOLOGY (2-card Bento)
       ══════════════════════════════════════════════════════════════ -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto">

      <!-- Header row -->
      <FadeIn>
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
          <div class="max-w-2xl">
            <span class="text-xs uppercase tracking-widest text-secondary font-bold">
              {bento.label}
            </span>
            <h2 class="text-4xl font-extrabold mt-4 tracking-tight">
              {bento.headline}
            </h2>
          </div>
          <p class="text-on-surface-variant max-w-xs text-sm">
            {bento.description}
          </p>
        </div>
      </FadeIn>

      <!-- Bento: 2 cards -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

        <!-- Card 1 (8-col): Aerial Surveillance — image bg, content at bottom -->
        <FadeIn class="md:col-span-8">
          <div class="group relative overflow-hidden rounded-xl bg-surface-container-low p-10 min-h-[400px] flex flex-col justify-end">
            <div class="absolute inset-0 z-0">
              {bento.cards[0].image && (
                <img
                  src={bento.cards[0].image}
                  alt=""
                  class="w-full h-full object-cover opacity-30 group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                  aria-hidden="true"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low to-transparent"></div>
            </div>
            <div class="relative z-10">
              <span
                class="material-symbols-outlined text-primary text-4xl mb-4 block"
                aria-hidden="true"
              >{bento.cards[0].icon}</span>
              <h3 class="text-2xl font-bold mb-2">{bento.cards[0].title}</h3>
              <p class="text-on-surface-variant max-w-md">{bento.cards[0].description}</p>
            </div>
          </div>
        </FadeIn>

        <!-- Card 2 (4-col): Soil Mesh — stat footer -->
        <FadeIn delay={100} class="md:col-span-4">
          <div class="bg-surface-container-lowest p-8 rounded-xl flex flex-col justify-between border border-outline-variant/15 h-full">
            <div>
              <div class="w-12 h-12 bg-secondary-container rounded-lg flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-on-secondary-container" aria-hidden="true">
                  {bento.cards[1].icon}
                </span>
              </div>
              <h3 class="text-xl font-bold mb-4">{bento.cards[1].title}</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed">{bento.cards[1].description}</p>
            </div>
            <div class="mt-8 pt-8 border-t border-outline-variant/10">
              <div class="flex justify-between items-center">
                <span class="text-xs font-bold uppercase tracking-widest text-secondary">
                  {bento.cards[1].statLabel}
                </span>
                <span class="text-lg font-black text-secondary">
                  {bento.cards[1].statValue}
                </span>
              </div>
            </div>
          </div>
        </FadeIn>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════
       SECTION 3 — RESTORING THE EARTH (Editorial)
       ══════════════════════════════════════════════════════════════ -->
  <section class="bg-surface-container-low py-24 px-6">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center">

      <!-- LEFT: image + floating metric chip -->
      <FadeIn direction="left" class="order-2 md:order-1 relative">
        <div class="rounded-xl overflow-hidden shadow-xl">
          {editorial.image ? (
            <img
              src={editorial.image}
              alt="Young green sprout growing in rich soil — HariLeaf regenerative agriculture"
              class="w-full aspect-[4/5] object-cover"
              loading="lazy"
            />
          ) : (
            <div class="aspect-[4/5] bg-surface-container flex items-center justify-center">
              <span
                class="material-symbols-outlined text-[5rem] text-primary/20"
                style="font-variation-settings: 'FILL' 1;"
                aria-hidden="true"
              >eco</span>
            </div>
          )}
        </div>
        <!-- Floating metric chip -->
        <div class="absolute -bottom-6 -right-6 bg-surface-container-lowest p-6 rounded-xl shadow-lg max-w-[200px]">
          <p class="text-xs font-bold text-tertiary mb-1">{editorial.metricLabel}</p>
          <p class="text-2xl font-black text-on-surface">
            {editorial.metricValue}<span class="text-sm font-medium"> {editorial.metricUnit}</span>
          </p>
        </div>
      </FadeIn>

      <!-- RIGHT: text + checklist -->
      <FadeIn direction="right" class="order-1 md:order-2 space-y-8">
        <span class="text-xs uppercase tracking-widest text-tertiary font-bold">
          {editorial.label}
        </span>
        <h2 class="text-5xl font-extrabold leading-tight tracking-tighter">
          {editorial.headline}
        </h2>
        <p class="text-lg text-on-surface-variant leading-relaxed">
          {editorial.body}
        </p>
        <ul class="space-y-4">
          {editorial.checklist.map((item: string) => (
            <li class="flex items-center gap-3">
              <span
                class="material-symbols-outlined text-primary flex-shrink-0"
                style="font-variation-settings: 'FILL' 1;"
                aria-hidden="true"
              >check_circle</span>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </FadeIn>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════
       SECTION 4 — MODERN INTELLIGENCE (3-col cards + CTA)
       ══════════════════════════════════════════════════════════════ -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <FadeIn>
        <div class="text-center mb-16 space-y-4">
          <span class="text-xs uppercase tracking-widest text-primary font-bold">
            {intelligence.label}
          </span>
          <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">
            {intelligence.headline}
          </h2>
        </div>
      </FadeIn>

      <!-- 3-column feature cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {intelligence.cards.map((card: { icon: string; title: string; description: string }, i: number) => (
          <FadeIn delay={i * 100}>
            <div class="p-8 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors group h-full">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-primary" aria-hidden="true">{card.icon}</span>
              </div>
              <h3 class="text-xl font-bold mb-3">{card.title}</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed">{card.description}</p>
            </div>
          </FadeIn>
        ))}
      </div>

      <!-- ── CTA Banner (email input) ────────────────────────────── -->
      <FadeIn>
        <div class="mt-20 rounded-2xl overflow-hidden relative p-12 text-center brand-gradient">
          <div class="relative z-10 max-w-2xl mx-auto space-y-6">
            <h3 class="text-3xl font-black text-white">{cta.headline}</h3>
            <p class="text-white/90">{cta.body}</p>
            <form
              method="POST"
              action="https://api.web3forms.com/submit"
              class="flex flex-col md:flex-row gap-4 justify-center items-center"
            >
              <input type="hidden" name="access_key" value={cta.web3formsKey ?? ''} />
              <input type="hidden" name="subject" value="Early Access Request — HariLeaf" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
              <input
                type="email"
                name="email"
                required
                placeholder={cta.inputPlaceholder}
                class="w-full md:w-80 px-6 py-4 rounded-full border-none focus:ring-2 focus:ring-white/50 focus:outline-none text-on-surface"
              />
              <button
                type="submit"
                class="bg-on-surface text-surface px-8 py-4 rounded-full font-bold hover:bg-on-surface/90 transition-colors active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 whitespace-nowrap"
              >
                {cta.buttonLabel}
              </button>
            </form>
          </div>
          <!-- Decorative blurs -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32 blur-3xl pointer-events-none" aria-hidden="true"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-black/10 rounded-full -ml-32 -mb-32 blur-3xl pointer-events-none" aria-hidden="true"></div>
        </div>
      </FadeIn>

    </div>
  </section>

</SiteLayout>
