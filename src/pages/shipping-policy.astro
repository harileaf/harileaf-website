---
export const prerender = false;
import { env } from 'cloudflare:workers';
import PolicyPage, { type PolicySection } from '../components/policy/PolicyPage.astro';
import { POLICY_CACHE, displayPhone, loadPolicySettings, orPending, rupeesSetting } from '../lib/store/policy-settings';

const s = await loadPolicySettings(env.STORE_DB);
Astro.response.headers.set('Cache-Control', POLICY_CACHE);
const minOrder = rupeesSetting(s.min_order_paise);
const codMax = rupeesSetting(s.cod_max_order_paise);

const sections: PolicySection[] = [
  {
    id: 'where',
    title: 'Where we deliver',
    paragraphs: [
      'We deliver across India to every pincode our courier partners serve. Enter your pincode on a product page or at checkout to check delivery to your address before you order.',
      'We currently ship our rice and spices. Fresh produce such as mangoes is not yet available for delivery.',
    ],
  },
  {
    id: 'charges',
    title: 'Delivery charges and minimum order',
    paragraphs: [
      `Delivery is free. The minimum order value is ${minOrder}, and the price you see at checkout is the full amount you pay — there are no extra delivery or cash-on-delivery fees.`,
    ],
  },
  {
    id: 'dispatch',
    title: 'Dispatch and delivery times',
    paragraphs: [
      'Orders are packed and dispatched within 2 business days of confirmation (Sundays and public holidays excluded).',
      'After dispatch, delivery usually takes 3–7 business days depending on your location. The estimated delivery date shown at checkout comes from our courier partner and may vary.',
    ],
  },
  {
    id: 'tracking',
    title: 'Tracking your order',
    paragraphs: [
      'When your order ships we email you a tracking link. You can also see its status any time from the order link in your confirmation email.',
    ],
  },
  {
    id: 'cod',
    title: 'Cash on delivery',
    paragraphs: [
      `Cash on delivery is available for orders up to ${codMax} at pincodes where our courier partner offers it. There is no fee for cash on delivery.`,
    ],
  },
  {
    id: 'failed',
    title: 'If a delivery fails',
    paragraphs: [
      'Our courier partner will attempt delivery and contact you if they cannot reach you. If a parcel comes back to us undelivered, we refund prepaid orders in full once it is received, and cancel cash-on-delivery orders.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    paragraphs: ['For any question about a delivery, contact our customer care team with your order number.'],
    rows: [
      { label: 'Phone', value: displayPhone(s.customer_care_phone) },
      { label: 'Email', value: orPending(s.customer_care_email), href: s.customer_care_email ? `mailto:${s.customer_care_email}` : undefined },
    ],
  },
];
---

<PolicyPage
  title="Shipping Policy"
  badge="Store"
  subtitle="How and where we deliver your order."
  updated="Last updated 18 October 2026"
  path="/shipping-policy"
  description="Free delivery across India to serviceable pincodes, dispatch within 2 business days, tracking by email and cash on delivery from HariLeaf."
  sections={sections}
/>
