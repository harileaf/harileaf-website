---
export const prerender = true;
import SiteLayout from '../layouts/SiteLayout.astro';
import FadeIn from '../components/animations/FadeIn.astro';
import CountUp from '../components/animations/CountUp.astro';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://harileaf.org');
const pageTitle = 'Technology | HariLeaf Agritech — IoT Sensors, Drone Monitoring & Smart Irrigation';
const pageDesc  = 'HariLeaf\'s precision agriculture stack: subterranean IoT soil sensors, hyperspectral aerial monitoring, and AI-driven drip irrigation — delivering 40% water savings and measurable yield uplift for commercial farms.';
---

<SiteLayout title={pageTitle} description={pageDesc}>
  <slot name="head" slot="head">
    <SEO title={pageTitle} description={pageDesc} canonicalUrl={canonicalURL} />
    <JsonLd
      type="BreadcrumbList"
      data={{
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home',       item: 'https://harileaf.org/' },
          { '@type': 'ListItem', position: 2, name: 'Technology', item: 'https://harileaf.org/technology' },
        ],
      }}
    />
  </slot>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
       ═══════════════════════════════════════════════════ -->
  <section class="relative px-6 py-20 lg:py-32 overflow-x-hidden">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16">

      <!-- Left column -->
      <div class="lg:w-1/2 space-y-8">
        <FadeIn>
          <div class="space-y-4">
            <span class="label-md uppercase tracking-widest text-secondary font-bold">The New Frontier</span>
            <h1 class="text-5xl lg:text-7xl font-bold tracking-tight text-on-surface leading-[1.1]">
              Outdoor AgTech <br/>
              <span class="text-primary italic">Perfected.</span>
            </h1>
          </div>
        </FadeIn>
        <FadeIn delay={100}>
          <p class="text-lg lg:text-xl text-on-surface-variant max-w-xl leading-relaxed">
            The Digital Greenhouse ecosystem bridges the gap between laboratory precision and the untamed reality of open-field farming through integrated sensing, aerial intelligence, and precision water management.
          </p>
        </FadeIn>
        <FadeIn delay={200}>
          <div class="flex flex-wrap gap-4 pt-4">
            <a
              data-magnetic
              href="#cycle-of-precision"
              class="brand-gradient text-on-primary px-8 py-4 rounded-full font-bold shadow-lg hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              Explore Infrastructure
            </a>
          </div>
        </FadeIn>
      </div>

      <!-- Right column -->
      <FadeIn direction="right" class="lg:w-1/2 relative">
        <!-- Decorative blur -->
        <div class="aspect-square rounded-full brand-gradient opacity-10 absolute -top-10 -right-10 blur-3xl w-full" aria-hidden="true"></div>
        <!-- Rotated image frame -->
        <div class="relative bg-surface-container-low rounded-xl p-4 transform rotate-2">
          <img
            src="/images/technology/hero-field.png"
            alt="Ultra-modern agritech field with autonomous drones flying over lush crop rows at sunrise with digital data overlays"
            class="rounded-lg shadow-2xl w-full h-[500px] object-cover"
            loading="eager"
          />
          <!-- Floating stat card -->
          <div class="absolute -bottom-6 -left-6 bg-surface-container-lowest p-6 rounded-lg shadow-xl max-w-[200px]">
            <span class="material-symbols-outlined text-primary text-3xl mb-2 block" aria-hidden="true">monitoring</span>
            <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Live Precision</p>
            <p class="text-2xl font-black text-secondary"><CountUp value={99.4} suffix="%" decimals={1} /></p>
          </div>
        </div>
      </FadeIn>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — THE CYCLE OF PRECISION
       ═══════════════════════════════════════════════════ -->
  <section id="cycle-of-precision" class="bg-surface-container-low py-24">
    <div class="max-w-7xl mx-auto px-6">

      <FadeIn>
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-3xl lg:text-4xl font-bold">The Cycle of Precision</h2>
          <p class="text-on-surface-variant max-w-2xl mx-auto">
            A self-sustaining loop of data, action, and optimization that turns variability into predictability.
          </p>
        </div>
      </FadeIn>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Dashed connector line (desktop only) -->
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-1 border-t-2 border-dashed border-outline-variant -translate-y-1/2 opacity-30" aria-hidden="true"></div>

        <!-- Step 1: Persevere -->
        <FadeIn>
          <div data-tilt class="bg-surface-container-lowest p-8 rounded-xl relative z-10 hover:translate-y-[-8px] transition-transform shadow-sm h-full">
            <div class="w-16 h-16 rounded-full brand-gradient flex items-center justify-center mb-6 shadow-md">
              <span class="material-symbols-outlined text-white text-3xl" aria-hidden="true">sensors</span>
            </div>
            <h3 class="text-xl font-bold mb-3">01. Persevere</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              Continuous data harvest from the Underground Mesh and Borne aerial systems creates a high-fidelity digital twin of the field.
            </p>
          </div>
        </FadeIn>

        <!-- Step 2: Synthesize -->
        <FadeIn delay={100}>
          <div data-tilt class="bg-surface-container-lowest p-8 rounded-xl relative z-10 hover:translate-y-[-8px] transition-transform shadow-sm h-full">
            <div class="w-16 h-16 rounded-full brand-gradient flex items-center justify-center mb-6 shadow-md">
              <span class="material-symbols-outlined text-white text-3xl" aria-hidden="true">psychology</span>
            </div>
            <h3 class="text-xl font-bold mb-3">02. Synthesize</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              Edge computing clusters process billion-point datasets in real-time, identifying metabolic shifts before they become visible to the eye.
            </p>
          </div>
        </FadeIn>

        <!-- Step 3: Execute -->
        <FadeIn delay={200}>
          <div data-tilt class="bg-surface-container-lowest p-8 rounded-xl relative z-10 hover:translate-y-[-8px] transition-transform shadow-sm h-full">
            <div class="w-16 h-16 rounded-full brand-gradient flex items-center justify-center mb-6 shadow-md">
              <span class="material-symbols-outlined text-white text-3xl" aria-hidden="true">precision_manufacturing</span>
            </div>
            <h3 class="text-xl font-bold mb-3">03. Execute</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              Precision irrigation systems deploy targeted water and nutrient interventions, ensuring every litre reaches exactly where the crop needs it.
            </p>
          </div>
        </FadeIn>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — DEEP DIVE: THE TRIAD
       ═══════════════════════════════════════════════════ -->
  <section class="py-24 max-w-7xl mx-auto px-6 space-y-32">

    <!-- Sub-section A: Aerial Surveillance: Borne™ -->
    <FadeIn>
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Left: text -->
        <div class="lg:w-1/2">
          <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full text-xs font-bold mb-6">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">flight</span>
            AERIAL STRATUM
          </div>
          <h2 class="text-4xl font-bold mb-6">Aerial Surveillance: Borne™</h2>
          <p class="text-on-surface-variant text-lg leading-relaxed mb-8">
            Our Borne fleet doesn't just watch; it analyzes. Equipped with hyperspectral imaging and LiDAR, these autonomous sentinels detect moisture stress and pest pressure days before a manual inspection could.
          </p>
          <ul class="space-y-4">
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">10cm Vertical Precision Navigation</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">Multi-Spectrum Chlorophyll Analysis</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">Solar-Linked Charging Hubs</span>
            </li>
          </ul>
        </div>
        <!-- Right: image -->
        <div class="lg:w-1/2">
          <div class="bg-surface-container rounded-3xl overflow-hidden aspect-[4/3]">
            <img
              src="/images/technology/borne-drone.png"
              alt="Sleek aerodynamic agritech drone soaring over a high-tech vineyard at sunset"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </FadeIn>

    <!-- Sub-section B: The Underground Mesh (reversed layout) -->
    <FadeIn>
      <div class="flex flex-col lg:flex-row-reverse items-center gap-16">
        <!-- Right: text (visually on right due to row-reverse) -->
        <div class="lg:w-1/2">
          <div class="inline-flex items-center gap-2 bg-tertiary-container text-on-tertiary-container px-4 py-1 rounded-full text-xs font-bold mb-6">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">grid_view</span>
            SUB-SURFACE STRATUM
          </div>
          <h2 class="text-4xl font-bold mb-6">The Underground Mesh</h2>
          <p class="text-on-surface-variant text-lg leading-relaxed mb-8">
            The secret to open-field control lies beneath the surface. Our decentralized mesh network of subterranean sensors monitors the rhizosphere—the root zone—with unprecedented density.
          </p>
          <div class="grid grid-cols-2 gap-6">
            <div class="bg-surface-container-low p-6 rounded-xl">
              <p class="text-primary font-black text-3xl mb-1"><CountUp value={98} suffix="%" /></p>
              <p class="text-xs uppercase font-bold text-on-surface-variant">Mesh Reliability</p>
            </div>
            <div class="bg-surface-container-low p-6 rounded-xl">
              <p class="text-secondary font-black text-3xl mb-1">5yr+</p>
              <p class="text-xs uppercase font-bold text-on-surface-variant">Battery Lifespan</p>
            </div>
          </div>
        </div>
        <!-- Left: image with decorative bg -->
        <div class="lg:w-1/2 relative">
          <div class="absolute inset-0 bg-primary opacity-5 rounded-3xl -rotate-3" aria-hidden="true"></div>
          <div class="bg-surface-container rounded-3xl overflow-hidden aspect-[4/3] relative">
            <img
              src="/images/technology/underground-mesh.png"
              alt="Cross-section view of soil showing digital sensor nodes attached to plant roots with data light pulses"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </FadeIn>

    <!-- Sub-section C: Precision Water Management -->
    <FadeIn>
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Left: text -->
        <div class="lg:w-1/2">
          <div class="inline-flex items-center gap-2 bg-primary-container text-on-primary-container px-4 py-1 rounded-full text-xs font-bold mb-6">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">water_drop</span>
            IRRIGATION STRATUM
          </div>
          <h2 class="text-4xl font-bold mb-6">Precision Water Management</h2>
          <p class="text-on-surface-variant text-lg leading-relaxed mb-8">
            Soil moisture readings from the Underground Mesh combine with local weather forecasts to drive irrigation only where and when the crop needs it — eliminating overwatering and runoff.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">Zone-level Moisture-Triggered Irrigation</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">40% Reduction in Water Usage</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1" aria-hidden="true">check_circle</span>
              <span class="font-medium">Integrated Rainfall Forecasting</span>
            </li>
          </ul>
          <blockquote class="p-6 bg-surface-container-highest rounded-xl border-l-4 border-primary">
            <p class="italic text-on-surface-variant">
              "Water is the most constrained resource in farming. We treat every litre like it counts."
            </p>
          </blockquote>
        </div>
        <!-- Right: image -->
        <div class="lg:w-1/2">
          <div class="bg-surface-container rounded-3xl overflow-hidden aspect-[4/3]">
            <img
              src="/images/technology/precision-irrigation.webp"
              alt="Close-up of drip irrigation emitter spraying water between rows of leafy green crops in rich soil"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </FadeIn>

  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — QUANTIFIABLE GROWTH
       ═══════════════════════════════════════════════════ -->
  <section class="bg-emerald-900 text-emerald-50 py-24 overflow-hidden relative">
    <!-- Decorative giant icon -->
    <div class="absolute top-0 right-0 w-1/3 h-full opacity-10" aria-hidden="true">
      <span class="material-symbols-outlined text-[400px] absolute -top-20 -right-20">biotech</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">

        <!-- Left: text content -->
        <FadeIn>
          <div>
            <h2 class="text-4xl lg:text-5xl font-black mb-8 leading-tight">
              Quantifiable Growth. <br/>Scientific Proof.
            </h2>
            <p class="text-emerald-100/70 text-lg mb-12">
              The HariLeaf tech stack isn't just about innovation—it's about outcomes. We track every variable to prove that sustainable tech is more profitable than legacy methods.
            </p>
            <div class="space-y-12">
              <div class="flex items-start gap-6">
                <div class="text-4xl font-black text-secondary-fixed shrink-0">01</div>
                <div>
                  <h4 class="text-xl font-bold mb-2">Water Optimization</h4>
                  <p class="text-emerald-100/60">
                    40% reduction in water waste through rhizosphere monitoring and localized atmospheric conditioning.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-6">
                <div class="text-4xl font-black text-secondary-fixed shrink-0">02</div>
                <div>
                  <h4 class="text-xl font-bold mb-2">Nitrogen Management</h4>
                  <p class="text-emerald-100/60">
                    Precise application reduces fertilizer runoff by 65%, protecting local watersheds and soil health.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </FadeIn>

        <!-- Right: bar chart card -->
        <FadeIn delay={100}>
          <div class="flex items-center">
            <div class="bg-white/5 backdrop-blur-md p-10 rounded-2xl border border-white/10 w-full">
              <span class="label-md mb-6 block text-emerald-300">Technology Impact Map</span>
              <div class="h-64 flex items-end gap-2 px-2">
                <div class="bg-emerald-400/20 w-full h-1/4 rounded-t-lg"></div>
                <div class="bg-emerald-400/40 w-full h-2/5 rounded-t-lg"></div>
                <div class="bg-emerald-400/60 w-full h-3/5 rounded-t-lg"></div>
                <div class="bg-primary-container w-full h-4/5 rounded-t-lg shadow-[0_0_20px_rgba(127,200,186,0.3)]"></div>
                <div class="bg-white w-full h-full rounded-t-lg shadow-[0_0_30px_rgba(255,255,255,0.2)]"></div>
              </div>
              <div class="mt-8 flex justify-between text-xs font-bold text-emerald-100/40 uppercase tracking-widest">
                <span>Traditional</span>
                <span>Hybrid</span>
                <span>HariLeaf v1</span>
                <span>HariLeaf v2</span>
                <span>Next Gen</span>
              </div>
            </div>
          </div>
        </FadeIn>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       SECTION 5 — CTA
       ═══════════════════════════════════════════════════ -->
  <section class="py-32 px-6 text-center">
    <FadeIn>
      <div class="max-w-4xl mx-auto space-y-10">
        <h2 class="text-4xl lg:text-6xl font-bold tracking-tight">Your farm called. It wants smarter water.</h2>
        <p class="text-xl text-on-surface-variant">
          Turns out soil has opinions. Let's find out what yours is trying to say — drop us a line and we'll take it from there.
        </p>
        <div class="flex justify-center">
          <a
            data-magnetic
            href="/contact"
            class="brand-gradient text-white px-10 py-5 rounded-full font-black text-lg shadow-xl hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            Talk to Us
          </a>
        </div>
      </div>
    </FadeIn>
  </section>

</SiteLayout>
