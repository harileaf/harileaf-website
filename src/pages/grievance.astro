---
export const prerender = false;
import { env } from 'cloudflare:workers';
import PolicyPage, { type PolicySection } from '../components/policy/PolicyPage.astro';
import { fssaiLabel } from '../lib/store/settings';
import { POLICY_CACHE, displayPhone, loadPolicySettings, phoneHref, orPending } from '../lib/store/policy-settings';

const s = await loadPolicySettings(env.STORE_DB);
Astro.response.headers.set('Cache-Control', POLICY_CACHE);
const mail = (e: string) => (e ? `mailto:${e}` : undefined);

const sections: PolicySection[] = [
  {
    id: 'seller',
    title: 'Seller details',
    paragraphs: ['Products on this website are sold by:'],
    rows: [
      { label: 'Legal name', value: orPending(s.legal_name) },
      { label: 'Trade name', value: orPending(s.trade_name) },
      { label: 'Address', value: orPending(s.address) },
      { label: 'GSTIN', value: orPending(s.gstin) },
      { label: fssaiLabel(s.fssai_license), value: orPending(s.fssai_license) },
    ],
  },
  {
    id: 'customer-care',
    title: 'Customer care',
    paragraphs: ['For questions about an order, delivery, cancellation or refund, contact customer care first with your order number. We usually reply within one working day.'],
    rows: [
      { label: 'Phone', value: displayPhone(s.customer_care_phone), href: phoneHref(s.customer_care_phone) },
      { label: 'Email', value: orPending(s.customer_care_email), href: mail(s.customer_care_email) },
    ],
  },
  {
    id: 'officer',
    title: 'Grievance officer',
    paragraphs: [
      'If your concern is not resolved by customer care, write to our grievance officer. We acknowledge every complaint within 48 hours and resolve it within one month of receiving it, as required by the Consumer Protection (E-Commerce) Rules, 2020.',
    ],
    rows: [
      { label: 'Name', value: orPending(s.grievance_officer_name) },
      { label: 'Designation', value: 'Grievance Officer' },
      { label: 'Email', value: orPending(s.grievance_officer_email), href: mail(s.grievance_officer_email) },
      { label: 'Phone', value: displayPhone(s.grievance_officer_phone), href: phoneHref(s.grievance_officer_phone) },
    ],
  },
  {
    id: 'how',
    title: 'How to raise a grievance',
    paragraphs: [
      'Please include your name, order number, contact details and a short description of the issue, with photos if relevant. We will reply to the email or phone number you give us.',
    ],
  },
  {
    id: 'helpline',
    title: 'National Consumer Helpline',
    paragraphs: [
      'You can also contact the Government of India National Consumer Helpline on 1915 or at consumerhelpline.gov.in.',
    ],
  },
];
---

<PolicyPage
  title="Grievance Redressal"
  badge="Store"
  subtitle="Seller details, customer care and our grievance officer."
  updated="2026-10-18"
  path="/grievance"
  contactPage
  description="HariLeaf seller details, customer care and grievance officer contact. Complaints are acknowledged within 48 hours and resolved within one month."
  sections={sections}
/>
