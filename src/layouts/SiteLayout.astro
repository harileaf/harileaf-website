---
/**
 * SiteLayout — full site shell: Header + main content + Footer.
 * All public-facing pages use this layout.
 *
 * Automatically injects Organization JSON-LD on every page so individual
 * pages don't need to repeat it. Pages only need to add page-specific schemas
 * (BreadcrumbList, WebSite, FAQPage, etc.) in their <slot name="head">.
 *
 * Props: passed through to BaseLayout (unused there now, kept for compat)
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import siteJson from '../content/site-settings.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  headerCtaVariant?: 'gradient' | 'container';
  headerLogoSize?: 'sm' | 'md';
}

const { title, description, ogImage, noIndex, headerCtaVariant, headerLogoSize } = Astro.props;

const SITE_BASE = (Astro.site ?? new URL('https://harileaf.ag')).origin;

// ── Organization schema — available on every marketing page ──────────────────
const orgSchema = {
  name: siteJson.title ?? 'HariLeaf Agritech',
  alternateName: 'HariLeaf',
  url: SITE_BASE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_BASE}${siteJson.logo ?? '/images/brand/logo-color.png'}`,
    width: 280,
    height: 80,
  },
  description: 'HariLeaf Agritech is an Indian precision agriculture company deploying IoT soil sensors, aerial crop monitoring, and AI-driven irrigation systems to increase farm yield and reduce water usage for commercial growers.',
  slogan: 'Open-field farming reimagined.',
  foundingDate: '2023',
  areaServed: ['IN', 'SG', 'AE'],
  knowsAbout: [
    'Precision Agriculture',
    'IoT Soil Sensors',
    'Aerial Crop Monitoring',
    'Drip Irrigation',
    'AI Yield Forecasting',
    'Sustainable Farming',
    'AgriTech',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Borivali',
    addressRegion: 'Mumbai',
    addressCountry: 'IN',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: siteJson.email ?? 'contact@harileaf.org',
      telephone: siteJson.phone ?? '+91-9820966177',
      contactType: 'customer support',
      availableLanguage: 'English',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'investor relations',
      email: siteJson.email ?? 'contact@harileaf.org',
      availableLanguage: 'English',
    },
  ],
  sameAs: (siteJson.socialLinks ?? []).map((s: { url: string }) => s.url).filter(Boolean),
};
---

<BaseLayout {title} {description} {ogImage} {noIndex}>

  <!-- Organization schema — injected before page-specific head content -->
  <JsonLd type="Organization" data={orgSchema} slot="head" />

  <!-- Page-specific head content (SEO, BreadcrumbList, WebSite, etc.) -->
  <slot name="head" slot="head" />

  <!-- Skip-to-content — hidden until focused, for keyboard/screen-reader users -->
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-float focus:outline-none"
    transition:name="skip-link"
  >
    Skip to main content
  </a>

  <Header ctaVariant={headerCtaVariant} logoSize={headerLogoSize} />

  <!-- Scroll progress bar — filled by interactions.ts -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/interactions';
</script>
